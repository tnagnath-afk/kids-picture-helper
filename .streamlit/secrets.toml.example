# Copy this file to .streamlit/secrets.toml for local runs.
# On Streamlit Community Cloud, paste these lines into App settings -> Secrets instead.
# NEVER commit the real secrets.toml to GitHub.

GEMINI_API_KEY = "paste-your-gemini-key-here"

# Optional: protects your paid image credits. Remove the line to disable.
APP_PASSWORD = "choose-a-password"
